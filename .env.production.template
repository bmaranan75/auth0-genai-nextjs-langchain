# Production Environment Variables Template
# Copy this to .env.production and fill in actual values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_BASE_URL="https://your-production-domain.com"
NEXTAUTH_URL="https://your-production-domain.com"

# =============================================================================
# AUTH0 CONFIGURATION
# =============================================================================
# SECURITY: Generate new secret for production!
# Run: openssl rand -hex 32
AUTH0_SECRET="GENERATE_NEW_SECRET_FOR_PRODUCTION"

AUTH0_DOMAIN="your-tenant.auth0.com"
AUTH0_CLIENT_ID="your_production_client_id"
AUTH0_CLIENT_SECRET="your_production_client_secret"
AUTH0_ISSUER_BASE_URL="https://your-tenant.auth0.com"
AUTH0_TOKEN_ENDPOINT="https://your-tenant.auth0.com/oauth/token"

# =============================================================================
# LANGGRAPH SERVER URL (CRITICAL!)
# =============================================================================
# Update this with your deployed LangGraph server URL
# Options:
#   - LangGraph Cloud: https://your-deployment.langchain.app
#   - Docker/VPS: https://langgraph.yourdomain.com
#   - Container URL: http://langgraph:2024 (if using docker-compose)
LANGGRAPH_SERVER_URL="https://your-langgraph-deployment.com"

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
OPENAI_API_KEY="sk-proj-YOUR_PRODUCTION_KEY"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Use production PostgreSQL with SSL
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# =============================================================================
# API ENDPOINTS
# =============================================================================
SHOP_API_URL="https://your-production-domain.com/api/checkout"
SHOP_API_AUDIENCE="https://your-production-domain.com/api/checkout"

ADD_PAYMENT_API_URL="https://your-production-domain.com/api/add-payment"
ADD_PAYMENT_API_AUDIENCE="https://your-production-domain.com/api/add-payment"

# =============================================================================
# LANGSMITH TRACING (MONITORING)
# =============================================================================
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="lsv2_pt_YOUR_PRODUCTION_KEY"
LANGCHAIN_PROJECT="auth0-shopping-agent-production"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# =============================================================================
# NOTIFICATIONS
# =============================================================================
PUSHOVER_TOKEN="your_production_pushover_token"
PUSHOVER_USER="your_production_pushover_user"

# =============================================================================
# IDENTITY PROVIDER
# =============================================================================
IDENTITY_PROVIDER="auth0"

# =============================================================================
# MCP CONFIGURATION (if using MCP features)
# =============================================================================
NEXTJS_URL="https://your-production-domain.com"
MCP_API_KEY="your_production_mcp_api_key"
MCP_SERVER_PORT="3001"
MCP_SERVER_HOST="0.0.0.0"
MCP_AUTH_MODE="hybrid"
MCP_API_AUDIENCE="https://your-production-domain.com/mcp"
ALLOWED_MCP_CLIENTS="chatgpt_enterprise_client_id,claude_client_id"
REQUIRED_MCP_SCOPES="mcp:execute"
